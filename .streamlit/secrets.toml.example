# Streamlit Community Cloud: App > Settings > Secrets. Paste the lines you need.
# For the public demo, DEMO_MODE = "true" is all that is required.
DEMO_MODE = "true"

# Optional: enables query embedding for semantic search in demo mode
# GEMINI_API_KEY = "..."

# Only for DEMO_MODE = "false" (uploads + live analysis)
# CLOUDINARY_URL = "cloudinary://<api_key>:<api_secret>@<cloud_name>"
