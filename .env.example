# Copy to .env for local runs. Never commit .env.

# true = read-only public demo from seed/analysis.json (no keys needed)
DEMO_MODE=true

# Cloudinary: Dashboard > API Keys > "API environment variable"
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AI provider (only "gemini" is implemented)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
